# ===== 追光平台 · 生产环境变量示例 =====
# 复制此文件为 .env 并按需填入
# 注意：.env 已在 .gitignore，切勿提交到公开仓库

# 1. JWT 密钥（强烈建议生产自行生成一段随机字符串，例如：openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# 2. 监听端口（大部分托管平台如 Render/Railway 会自动设置 PORT，无需手动改）
PORT=3001

# 3. SQLite 数据库路径（必须是可读写路径；VPS 用默认即可；Render 持久盘请设为 /var/data/zhuiguang.db）
DB_PATH=./server/zhuiguang.db

# 4. 文件上传目录（与 DB_PATH 同理，Render 持久盘请设为 /var/data/uploads）
UPLOAD_DIR=./server/uploads

# 5. （可选）CORS 白名单，多个用英文逗号分隔，留空表示允许所有来源
CORS_ORIGIN=
