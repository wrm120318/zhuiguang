# ===== 追光平台 · 生产环境变量示例 =====
# 复制此文件为 .env 并按需填入
# 注意：.env 已在 .gitignore，切勿提交到公开仓库

# ============ 1. 应用基础 ============
# JWT 密钥（强烈建议生产自行生成一段随机字符串，例如：openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d
# 监听端口（大部分托管平台如 Render 会自动设置 PORT，无需手动改）
PORT=3001

# ============ 2. 数据库（Turso / libSQL，免费 9GB） ============
# 获取方式见部署文档：https://turso.tech → Sign up → Create database
# 远程：libsql://<db-name>-<org>.turso.io
# 本地开发：file:./server/local.db
TURSO_DATABASE_URL=file:./server/local.db
# 远程数据库的访问令牌（本地 file: 模式留空即可）
TURSO_AUTH_TOKEN=

# ============ 3. 文件存储（Supabase Storage，免费 1GB） ============
# 获取方式见部署文档：https://supabase.com → New project
# Settings → API → Project URL 与 service_role key
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key（服务端用，可绕过 RLS；切勿泄露到前端）
SUPABASE_SERVICE_KEY=eyJhbGciOi...
# bucket 名称（需在 Supabase 控制台先创建，并设为 Public）
SUPABASE_BUCKET=zhuiguang-files

# ============ 4. （可选）CORS 白名单 ============
# 多个用英文逗号分隔，留空表示允许所有来源
CORS_ORIGIN=
